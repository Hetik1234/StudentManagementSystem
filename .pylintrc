[MASTER]
ignore=migrations
ignore-patterns=test_.*,testsuite
load-plugins=pylint_django

django-settings-module=sms_project.settings

jobs=1
persistent=yes

[MESSAGES CONTROL]
disable=
    missing-docstring,
    invalid-name,
    too-few-public-methods,
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    no-member,
    duplicate-code,
    too-many-instance-attributes,
    unnecessary-pass,
    useless-super-delegation,
    fixme,
    broad-except,
    import-error,
    wrong-import-order,
    no-else-return,
    line-too-long

enable=
    unused-variable,
    unused-import,
    undefined-variable

[REPORTS]
score=yes

[FORMAT]
max-line-length=120

[TYPECHECK]
ignored-modules=
    django,
    django.db,
    django.conf,
    django.contrib,
    django.shortcuts,
    django.urls,
    django.http,
    django.core,
    rest_framework

[DESIGN]
max-args=10
max-attributes=12
max-locals=20
max-branches=20
max-statements=80

[SIMILARITIES]
min-similarity-lines=10

[EXCEPTIONS]
overgeneral-exceptions=Exception

